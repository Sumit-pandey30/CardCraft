# ===================================================================
# CardCraft Environment Variables Example
# Duplicate this file as .env or set environment variables in your system
# ===================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Backend Server Configuration
SERVER_PORT=8080
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/cardcraft_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# JWT Security
# Must be at least 256 bits (32+ bytes) hex or base64 encoded
JWT_SECRET=your_secure_256_bit_secret_key_here_minimum_32_characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Default Initial Administrator Account
ADMIN_EMAIL=admin@cardcraft.io
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=CardCraft Administrator
